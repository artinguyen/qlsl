@using PagedList.Mvc;
@model PagedList.IPagedList<QLXDK.Models.Views.BookingListVm>
@{
    ViewBag.Title = "Booking";
}
@{
    int currentPage = ViewBag.CurrentPage ?? 1;
}
<div class="col-md-6">
    @if (TempData["Message"] != null)
            {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

</div>
<div class="col-md-6">
    @*<input type="text" id="searchBox" placeholder="Search..." class="form-control float-md-end" />*@
    <div class="">
        <form class="header-search float-md-end d-md-flex">
            <input type="search" id="searchBox" class="form-control me-2" placeholder="Tìm kiếm booking">
            <button type="button" class="btn btn-info float-md-end" onclick="window.location.href='@Url.Action("Create", "Booking")'"><i class="ti ti-circle-plus" ></i>Thêm</button>
        </form>
        <section class="">
            
        </section>
    </div>
        

</div>
<div id="resultsContainer">
    <div class="col-md-12">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Booking No</th>
                    <th>Vessel/Voyage</th>
                    <th>Depot Name</th>
                    <th>Port Of Loading</th>
                    <th>Sailing Date</th>
                    <th>Closing Date</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int stt = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                }
                @foreach (var item in Model)
            {
                    <tr>
                        <td>@(stt++)</td>
                        <td>@item.BookingNo</td>
                        <td>@item.Vessel</td>
                        <td>@item.DepotName</td>
                        <td>@item.PortName</td>
                        <td>@item.SailingDate</td>
                        <td>@item.ClosingDate</td>
                        <td class="text-center">
                            <a href="@Url.Action("Edit", "Booking", new { id = item.ID })"
                               class="btn btn-success" title="Sửa">
                                <i class="fa fa-edit"></i>
                            </a>
                            <a href="#"
                               class="btn btn-danger"
                               data-bs-toggle="modal" data-bs-target="#deleteModalLive"
                               title="Xóa"
                               onclick="deleteConfirm('@Url.Action("Delete", "Booking", new { id = item.ID })'); return false;">
                                <i class="fa fa-trash"></i>
                            </a>
                            <a href="#" data-bs-toggle="modal" data-bs-target="#detailModalLive"
                               class="btn btn-success" title="Sửa" onclick="getDetail(@item.ID); return false;">
                                <i class="ti ti-ad-2"></i>
                            </a>
                            
                        </td>
                    </tr>
                }

            </tbody>
        </table>

        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }),
    new PagedListRenderOptions
    {
        UlElementClasses = new string[] { "pagination" },
        LiElementClasses = new string[] { "page-item" },
        FunctionToTransformEachPageLink = (liTag, aTag) =>
        {
            aTag.Attributes.Add("class", "page-link");

            if (liTag.Attributes.ContainsKey("class") && liTag.Attributes["class"].Contains("PagedList-skipToPage"))
            {
                liTag.Attributes["class"] = "page-item active";
            }

            liTag.InnerHtml = aTag.ToString();
            return liTag;
        },
        LinkToPreviousPageFormat = "«",
        LinkToNextPageFormat = "»",
        DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
        DisplayLinkToNextPage = PagedListDisplayMode.Always,
        MaximumPageNumbersToDisplay = 5
    })
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#searchBox").on("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    var searchText = $(this).val();
                    //if ((searchText.trim()) == "") return;
                    $.ajax({
                        url: '@Url.Action("Search", "Booking")',
                        data: { q: searchText },
                        success: function (data) {
                            $("#resultsContainer").html(data);
                        }
                    });
                }
            });

            

        });
        // Detail
        function getDetail(id) {
            //alert('abc')
            $.ajax({
                url: '@Url.Action("Detail", "Booking")',
                data: { id: id },
                success: function (data) {
                    $("#detailBooking").html(data);
                    //$('#detailModalLive').modal('show');
                }
            });
        }
    </script>
}
<div id="deleteModalLive" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="deleteModalLiveLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLiveLabel">Thông báo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có muốn xoá thông tin này không?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Không</button>
                <button type="button" class="btn btn-primary" onclick="deleteOK()">Có</button>
            </div>
        </div>
    </div>
</div>

<div id="detailModalLive" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="detailModalLiveLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết booking</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="detailBooking"></div>
        </div>
    </div>
</div>

