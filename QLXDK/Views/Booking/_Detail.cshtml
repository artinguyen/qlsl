@model QLXDK.Models.Views.BookingListVm
<div class="table-responsive">
    <table class="table">
       
        <tbody>
            <tr>
                <td>Booking No</td>
                <td>@Model.BookingNo</td>
            </tr>
            <tr>
                <td>Vessel/Voyage</td>
                <td>@Model.Vessel</td>
            </tr>
            <tr>
                <td>Port of Loading</td>
                <td>@Model.PortName</td>
            </tr>
            <tr>
                <td>Sailing Date</td>
                <td>@Model.SailingDate</td>
            </tr>
            <tr>
                <td>Closing Date</td>
                <td>@Model.ClosingDate</td>
            </tr>
            <tr>
                <td>SL Closing Time</td>
                <td>@Model.SlClosingTime</td>
            </tr>
            <tr>
                <td>VGM Closing Date</td>
                <td>@Model.VgmClosingDate</td>
            </tr>
            <tr>
                <td>VGM Closing Time</td>
                <td>@Model.VgmClosingTime</td>
            </tr>
            <tr>
                <td>Quantity</td>
                <td>@Model.Quantity</td>
            </tr>
            <tr>
                <td>Pick Up At</td>
                <td>@Model.PickupAt</td>
            </tr>
            <tr>
                <td>Return To</td>
                <td>@Model.ReturnAt</td>
            </tr>
            <tr>
                <td>Remarks</td>
                <td>@Model.Remark</td>
            </tr>
        </tbody>
    </table>
</div>