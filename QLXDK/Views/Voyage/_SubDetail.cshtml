@*@model IEnumerable<QLXDK.Models.Entities.VoyageDetail>*@
@model IEnumerable<QLXDK.Models.Views.VoyageDetailRow>
<div class="row">
    <div class="col-md-6">
        @if (TempData["Message"] != null)
            {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>
    <div class="col-md-12">
        <input id="SubVoyageId" value="@ViewBag.SubVoyageId" name="SubVoyageId" type="hidden" />
        <button class="btn btn-primary" type="button" id="btnApprove">Approve</button>
        <button class="btn btn-danger" type="button" id="btnDelete">Delete</button>
    </div>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <th><input type="checkbox" id="checkAll"></th>
            <th>ContainerNo</th>
            <th>SizeType</th>
            <th>Line</th>
            <th>BookingBillNo</th>
            <th>SealNo</th>
            <th>FullEmpty</th>
            <th>Category</th>
            <th>VesVoyName</th>
            <th>PortOfLoad</th>
            <th>PortOfDischarge</th>
            <th>GrossWeight</th>
            <th>VGM</th>
            <th>TemperatureC</th>
            <th>IMO</th>
            <th>UN</th>
            <th>Commodity</th>
            <th>Remarks</th>
            <th>Status</th>
            <th>Approved By</th>
            </thead>
            <tbody>

                @foreach (var item in Model)
            {
                    <tr data-id="@item.Detail.ID">
                        <td>@(item.Detail.ApprovedDate == null ? Html.Raw("<input type='checkbox' class='row-select'/>") : Html.Raw(""))</td>
                        <td>@item.Detail.ContainerNo</td>
                        <td>@item.Detail.SizeType</td>
                        <td>@item.Detail.Line</td>
                        <td>@item.Detail.BookingBillNo</td>
                        <td>@item.Detail.SealNo</td>
                        <td>@item.Detail.FullEmpty</td>
                        <td>@item.Detail.Category</td>
                        <td>@item.Detail.VesVoyName</td>
                        <td>@item.Detail.PortOfLoad</td>
                        <td>@item.Detail.PortOfDischarge</td>
                        <td>@item.Detail.GrossWeight</td>
                        <td>@item.Detail.VGM</td>
                        <td>@item.Detail.TemperatureC</td>
                        <td>@item.Detail.IMO</td>
                        <td>@item.Detail.UN</td>
                        <td>@item.Detail.Commodity</td>
                        <td>@item.Detail.Remarks</td>

                        <td>@Html.Raw(item.Detail.ApprovedDate == null ? "<span class='badge bg-secondary'>Waiting</span>" : "<span class='badge bg-success'>Approved</span>")</td>
                        <td>@item.ApprovedByUsername</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>